# This server branch is intentionally allow-listed. Everything is ignored
# unless explicitly required to build, test, or reproduce the paper matrix.
/*

# Root build, documentation, executable source, and reviewed workbook.
!/.gitignore
!/Makefile
!/README.md
!/driver.cpp
!/all_paper_algorithms_comparison_2026-08-24.xlsx
!/output/
/output/*
!/output/all_paper_algorithms_comparison_2026-08-24.xlsx

# Active headers only.
!/inc/
/inc/*
!/inc/cbs.h
!/inc/config.h
!/inc/map_loader.h
!/inc/path_planners.h
!/inc/simulation.h
!/inc/types.h

# Active implementation files only.
!/src/
/src/*
!/src/cbs.cpp
!/src/map_loader.cpp
!/src/path_planners.cpp
!/src/simulation.cpp

# Reproduction and repository checks.
!/scripts/
/scripts/*
!/scripts/run_server_matrix.py
!/scripts/check_repository_manifest.py

# Reviewed handover only.
!/history/
/history/*
!/history/2026-08-24_linux_server_handover.md

# GitHub validation workflow.
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/linux-smoke.yml

# Focused regression inputs.
!/tests/
/tests/*
!/tests/multigoal-5.task
!/tests/multigoal-10.tour

# Required small benchmark maps and task streams only.
!/data/
/data/*
!/data/Instances/
/data/Instances/*
!/data/Instances/small/
/data/Instances/small/*
!/data/Instances/small/kiva-10-500-5.map
!/data/Instances/small/kiva-20-500-5.map
!/data/Instances/small/kiva-30-500-5.map
!/data/Instances/small/kiva-40-500-5.map
!/data/Instances/small/kiva-50-500-5.map
!/data/Instances/small/kiva-0.2.task
!/data/Instances/small/kiva-0.5.task
!/data/Instances/small/kiva-1.task
!/data/Instances/small/kiva-2.task
!/data/Instances/small/kiva-5.task
!/data/Instances/small/kiva-10.task
!/data/Instances/small/kiva-500.task

# Precomputed LKH3 tours required by the two offline TA algorithms.
!/tour/
/tour/*
!/tour/10-500.tour
!/tour/20-500.tour
!/tour/30-500.tour
!/tour/40-500.tour
!/tour/50-500.tour

# Final generated benchmark assets and their reproducibility scripts.
!benchmark_instances/
!benchmark_instances/**
benchmark_instances/.DS_Store
!/scripts/generate_paper_large_instance.py
!/scripts/generate_structured_small_medium.py
!/scripts/generate_sparse_medium_grid_instance.py
!/scripts/generate_benchmark_task_matrix.py
!/scripts/generate_benchmark_lkh_tours.py
!/scripts/validate_benchmark_completeness.py
!/scripts/render_warehouse_comparison.py
!/scripts/render_pickup_heatmaps.py
!/scripts/render_delivery_heatmaps.py
